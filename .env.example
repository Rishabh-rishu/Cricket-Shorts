# Cricket Shorts Automation Configuration

# Publish Mode: Set to true only when you have authorized YouTube OAuth and want automatic upload
AUTO_UPLOAD=false

# YouTube API Credentials
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_TOKEN_FILE=token.pickle

# Scheduling (Asia/Kolkata timezone)
SCHEDULE_MORNING_TIME=11:00
SCHEDULE_EVENING_TIME=19:00
TIMEZONE=Asia/Kolkata

# Voice Settings
TTS_ENGINE=edge-tts
TTS_VOICE=hi-IN-MadhurNeural
SPEECH_SPEED=1.20
VOICE_PITCH=-2Hz

# Fact Quality Threshold (out of 100)
MIN_FACT_SCORE=80

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Cricket Shorts Cinematic Video Engine V3 Configuration

# Google Gemini API Key (active model: gemini-3.5-flash-lite)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Pexels Video API Key (for real 1080p moving cricket footage)
# Get your free key at: https://www.pexels.com/api/
PEXELS_API_KEY=

# YouTube Publishing
AUTO_UPLOAD=false
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_TOKEN_FILE=token.pickle

# Video Specifications (Engine V3)
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VOICE_SPEED=1.22
VIDEO_MIN_DURATION=35
VIDEO_MAX_DURATION=50

# Scheduling & Timezone (Asia/Kolkata)
SCHEDULE_MORNING_TIME=11:00
SCHEDULE_EVENING_TIME=19:00
TIMEZONE=Asia/Kolkata

# Voice & Narration Engine
TTS_ENGINE=edge-tts
TTS_VOICE=hi-IN-MadhurNeural
VOICE_PITCH=-2Hz

# Fact Quality Scoring Threshold
MIN_FACT_SCORE=80

# Logging
LOG_LEVEL=INFO

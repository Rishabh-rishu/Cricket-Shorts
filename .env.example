# Cricket Shorts Cinematic Video Engine V2 Configuration

# Google Gemini API Key (for intelligent research, scriptwriting, and scene planning)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Pexels Video API Key (for real moving cricket video footage)
# Get your free key at: https://www.pexels.com/api/
PEXELS_API_KEY=

# YouTube Publishing
AUTO_UPLOAD=false
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_TOKEN_FILE=token.pickle

# Video Specifications
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VOICE_SPEED=1.2
VIDEO_MIN_DURATION=30
VIDEO_MAX_DURATION=45

# Scheduling & Timezone (Asia/Kolkata)
SCHEDULE_MORNING_TIME=11:00
SCHEDULE_EVENING_TIME=19:00
TIMEZONE=Asia/Kolkata

# Voice & Narration Engine
TTS_ENGINE=edge-tts
TTS_VOICE=hi-IN-MadhurNeural
VOICE_PITCH=-2Hz

# Fact Quality Scoring Threshold
MIN_FACT_SCORE=80

# Logging
LOG_LEVEL=INFO
